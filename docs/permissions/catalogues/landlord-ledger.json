        {
          "key": "accountant",
          "label": "Accountant",
          "tier": "hod",
          "reach": "all",
          "appRole": "accountant"
        },
        {
          "key": "bookkeeper",
          "label": "Bookkeeper",
          "tier": "officer",
          "reach": "all"
        }
      ]
    },
    {
      "key": "operations",
      "label": "Operations",
