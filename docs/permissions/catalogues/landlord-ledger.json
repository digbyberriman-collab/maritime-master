        {
          "key": "property_manager",
          "label": "Property Manager",
          "tier": "hod",
          "levelCodes": {
            "unit": "P"
          },
          "appRole": "agent"
        },
        {
          "key": "letting_agent",
          "label": "Letting Agent",
          "tier": "officer",
          "levelCodes": {
            "unit": "P"
          },
          "appRole": "agent"
        }
      ]
    },
    {
      "key": "finance",
      "label": "Finance",
      "signOffBy": "Owner",
