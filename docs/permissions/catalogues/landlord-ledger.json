  "separationOfDuties": [
    {
      "id": "SOD-01",
      "a": "property.money.expenses.approve",
      "b": "property.money.expenses.settle",
      "level": "role",
      "approverTiers": [
        "command"
      ],
      "description": "Expense approver cannot mark it paid."
    },
    {
      "id": "SOD-02",
      "a": "account.settings.permission_matrix_import.approve",
      "b": "account.settings.permission_matrix_import.create",
      "level": "record",
      "description": "Uploader and applier differ when a co-owner exists; a sole owner may do both (logged)."
    },
    {
      "id": "SOD-03",
      "a": "property.operations.maintenance.edit",
      "b": "property.operations.maintenance.approve",
      "level": "record",
      "description": "Contractor who updates a job cannot approve its completion."
    },
    {
      "id": "SOD-04",
      "a": "account.settings.team_access.assign",
      "b": "account.settings.team_access.admin",
      "level": "record",
      "description": "Nobody grants access to themselves."
    }
  ],
  "signOffExtras": [
    {
      "area": "Personal Finance (never shared)",
      "by": "Owner"
    },
    {
      "area": "Tenant data (T2 / T3)",
      "by": "Owner (data controller)"
    }
  ],
