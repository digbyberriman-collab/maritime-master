  "accessSets": [
    {
      "key": "owner",
      "label": "Owner",
      "tier": "command",
      "reach": "all",
      "description": "Account holder"
    },
    {
      "key": "co_owner",
      "label": "Co-owner",
      "tier": "command",
      "reach": "unit",
      "description": "Entity director"
    },
    {
      "key": "manager",
      "label": "Manager",
      "tier": "hod",
      "description": "Property manager"
    },
    {
      "key": "agent",
      "label": "Agent",
      "tier": "officer",
      "description": "Letting agent"
    },
    {
      "key": "accountant",
      "label": "Accountant",
      "tier": "hod",
      "reach": "all",
      "description": "Accountant / bookkeeper"
    },
    {
      "key": "contractor",
      "label": "Contractor",
      "tier": "rating",
      "levelCodes": {
        "group": "S",
        "unit": "S"
