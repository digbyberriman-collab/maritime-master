{
  "pmsVersion": "1.0",
  "app": {
    "id": "landlord-ledger",
    "name": "Landlord Ledger",
    "repo": "digbyberriman-collab/landlord-ledger",
    "status": "DRAFT"
  },
  "unitLabel": "Property / Entity",
  "scopes": [
    {
      "code": "S",
      "key": "self",
      "label": "Self",
      "description": "Own lease / own tenant record / own assigned jobs"
    },
    {
      "code": "P",
      "key": "property",
      "label": "Property",
      "description": "Assigned property(ies)"
    },
    {
      "code": "E",
      "key": "entity",
      "label": "Entity",
      "description": "All properties held by an assigned ownership entity"
    },
    {
      "code": "A",
      "key": "account",
      "label": "Account",
      "description": "The whole owner account (portfolio)"
    }
  ],
  "levels": {
    "self": "S",
    "group": "P",
    "unit": "E",
    "all": "A"
  },
  "sensitivityNotes": {
    "T0": "anyone with any role on the account",
    "T1": "operational property records",
    "T2": "tenant PII, rent, leases, finance — audited, reason required",
    "T3": "personal finance (fin_*), tenant ID / screening — owner only or named holders"
  },
  "actionNotes": {
    "sign": "sign a lease",
    "settle": "record a payment / mark paid",
    "assign": "assign a contractor / invite a team member"
  },
  "defaults": {
    "tier": "T1",
    "actions": "read"
  },
  "departments": [
